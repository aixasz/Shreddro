<?xml version="1.0" encoding="utf-8"?>
<!--
  Shreddro launcher foreground: "slip being shredded" glyph.
  Evolved from the in-app header glyph (design/Main.dc.html) — an outlined
  receipt slip with three shred strips of differing lengths hanging below.
  All geometry sits inside the 66dp adaptive-icon safe zone (circle r=33
  centered at 54,54): glyph bounds are x 38..70, y 36..74 (~58% of safe zone).
  Stroke look is achieved with filled paths only (4dp weight) for maximum
  renderer compatibility.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Slip body: outer rounded rect (r=5) minus inner rounded rect (r=2),
         even-odd fill gives a 4dp outline -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M43,36 L65,36 A5,5 0 0 1 70,41 L70,47 A5,5 0 0 1 65,52 L43,52 A5,5 0 0 1 38,47 L38,41 A5,5 0 0 1 43,36 Z M44,40 L64,40 A2,2 0 0 1 66,42 L66,46 A2,2 0 0 1 64,48 L44,48 A2,2 0 0 1 42,46 L42,42 A2,2 0 0 1 44,40 Z" />

    <!-- Shred strip, left (long): 4dp rounded bar, y 56..72 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,58 A2,2 0 0 1 45,58 L45,70 A2,2 0 0 1 41,70 Z" />

    <!-- Shred strip, middle (short): y 56..67 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52,58 A2,2 0 0 1 56,58 L56,65 A2,2 0 0 1 52,65 Z" />

    <!-- Shred strip, right (longest): y 56..74 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,58 A2,2 0 0 1 67,58 L67,72 A2,2 0 0 1 63,72 Z" />
</vector>
