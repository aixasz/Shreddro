<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for LLM parsing + cloud sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Gallery read access, tiered by API level (scoped storage only) -->
    <!-- API 33+ granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- API 34+ partial photo access grant -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- API 29-32 legacy read (maxSdkVersion caps it) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Batch-result notifications (API 33+ runtime prompt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NOTE: no WRITE_EXTERNAL_STORAGE, no MANAGE_EXTERNAL_STORAGE.
         Deletion goes through MediaStore.createDeleteRequest() user consent. -->

    <!-- Package visibility (API 30+): lets the Account screen check whether
         the native Sheets / Drive / Excel / OneDrive apps are installed before
         deep-linking; otherwise links open in the browser. -->
    <queries>
        <package android:name="com.google.android.apps.docs.editors.sheets" />
        <package android:name="com.google.android.apps.docs" />
        <package android:name="com.microsoft.office.excel" />
        <package android:name="com.microsoft.skydrive" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="ms-excel" />
        </intent>
        <!-- Viewers for the local .xlsx ledger (MainActivity.openLocalLedger). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        </intent>
    </queries>

    <application
        android:name=".ShreddroApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="false"
        android:theme="@style/Theme.Shreddro"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AppAuth redirect capture for Google OIDC (custom scheme from
             manifestPlaceholders: com.shreddro.app:/oauth2redirect) -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appAuthRedirectScheme}" />
            </intent-filter>
            <!-- Microsoft identity platform redirect (msauth scheme).
                 Replace the host signature hash with your release keystore's
                 base64 SHA-1 as registered in the Entra app portal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="com.shreddro.app"
                    android:path="/mdiqEPddjqIocm44yXlmGKnFWqU="
                    android:scheme="msauth" />
            </intent-filter>
        </activity>

        <!-- Shares the local Excel ledger (Documents/Shreddro Transactions.xlsx,
             written when no cloud account is linked) with a viewer app via a
             content:// URI; roots in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager default initializer is used; SlipScanWorker scheduled at runtime -->
    </application>
</manifest>
